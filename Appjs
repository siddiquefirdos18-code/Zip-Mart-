import React, { useState } from 'react';
import { 
  StyleSheet, 
  Text, 
  View, 
  ScrollView, 
  TouchableOpacity, 
  Image, 
  SafeAreaView, 
  StatusBar,
  Modal,
  Alert
} from 'react-native';

// --- Sample Data ---
const PRODUCTS = [
  { id: '1', name: 'Fresh Milk 1L', price: 66, category: 'Dairy', image: 'https://picsum.photos/200/200?random=1' },
  { id: '2', name: 'Brown Bread', price: 45, category: 'Bakery', image: 'https://picsum.photos/200/200?random=2' },
  { id: '3', name: 'Organic Eggs (6pcs)', price: 55, category: 'Dairy', image: 'https://picsum.photos/200/200?random=3' },
  { id: '4', name: 'Instant Coffee 100g', price: 180, category: 'Beverages', image: 'https://picsum.photos/200/200?random=4' },
];

export default function App() {
  const [cart, setCart] = useState<{ [key: string]: number }>({});
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);

  const addToCart = (id: string) => {
    setCart(prev => ({ ...prev, [id]: (prev[id] || 0) + 1 }));
  };

  const removeFromCart = (id: string) => {
    setCart(prev => {
      const updated = { ...prev };
      if (updated[id] > 1) {
        updated[id] -= 1;
      } else {
        delete updated[id];
      }
      return updated;
    });
  };

  const getTotalCount = () => Object.values(cart).reduce((a, b) => a + b, 0);

  const getTotalPrice = () => {
    return Object.entries(cart).reduce((sum, [id, qty]) => {
      const item = PRODUCTS.find(p => p.id === id);
      return sum + (item ? item.price * qty : 0);
    }, 0);
  };

  const total = getTotalPrice();
  const deliveryFee = total >= 299 || total === 0 ? 0 : 20;
  const grandTotal = total > 0 ? total + deliveryFee + 5 : 0;

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar barStyle="light-content" backgroundColor="#121212" />
      
      {/* Header */}
      <View style={styles.header}>
        <View>
          <Text style={styles.brandTitle}>⚡ QuickMart</Text>
          <Text style={styles.subTitle}>Delivery in 12-15 mins</Text>
        </View>
      </View>

      {/* Product List */}
      <ScrollView contentContainerStyle={styles.productList}>
        <Text style={styles.sectionHeading}>Daily Essentials</Text>
        
        <View style={styles.grid}>
          {PRODUCTS.map(product => {
            const qty = cart[product.id] || 0;
            return (
              <View key={product.id} style={styles.card}>
                <Image source={{ uri: product.image }} style={styles.cardImage} />
                <Text style={styles.cardTitle} numberOfLines={1}>{product.name}</Text>
                <Text style={styles.cardPrice}>₹{product.price}</Text>

                {qty === 0 ? (
                  <TouchableOpacity style={styles.addBtn} onPress={() => addToCart(product.id)}>
                    <Text style={styles.addBtnText}>ADD</Text>
                  </TouchableOpacity>
                ) : (
                  <View style={styles.qtyContainer}>
                    <TouchableOpacity style={styles.qtyBtn} onPress={() => removeFromCart(product.id)}>
                      <Text style={styles.qtyBtnText}>-</Text>
                    </TouchableOpacity>
                    <Text style={styles.qtyText}>{qty}</Text>
                    <TouchableOpacity style={styles.qtyBtn} onPress={() => addToCart(product.id)}>
                      <Text style={styles.qtyBtnText}>+</Text>
                    </TouchableOpacity>
                  </View>
                )}
              </View>
            );
          })}
        </View>
      </ScrollView>

      {/* Floating Cart Bar */}
      {getTotalCount() > 0 && (
        <View style={styles.cartBar}>
          <View>
            <Text style={styles.cartBarCount}>{getTotalCount()} ITEMS</Text>
            <Text style={styles.cartBarPrice}>₹{grandTotal}</Text>
          </View>
          <TouchableOpacity style={styles.checkoutBtn} onPress={() => setIsCheckoutOpen(true)}>
            <Text style={styles.checkoutBtnText}>View Cart →</Text>
          </TouchableOpacity>
        </View>
      )}

      {/* Checkout Modal */}
      <Modal visible={isCheckoutOpen} animationType="slide" transparent={true}>
        <View style={styles.modalOverlay}>
          <View style={styles.modalContent}>
            <View style={styles.modalHeader}>
              <Text style={styles.modalTitle}>Order Summary</Text>
              <TouchableOpacity onPress={() => setIsCheckoutOpen(false)}>
                <Text style={styles.closeText}>✕</Text>
              </TouchableOpacity>
            </View>

            <ScrollView style={{ maxHeight: 250 }}>
              {Object.entries(cart).map(([id, qty]) => {
                const item = PRODUCTS.find(p => p.id === id);
                if (!item) return null;
                return (
                  <View key={id} style={styles.cartRow}>
                    <Text style={styles.cartRowName}>{item.name} x {qty}</Text>
                    <Text style={styles.cartRowPrice}>₹{item.price * qty}</Text>
                  </View>
                );
              })}
            </ScrollView>

            <View style={styles.billBox}>
              <View style={styles.billRow}>
                <Text style={styles.billLabel}>Item Total</Text>
                <Text style={styles.billVal}>₹{total}</Text>
              </View>
              <View style={styles.billRow}>
                <Text style={styles.billLabel}>Delivery Fee</Text>
                <Text style={styles.billVal}>{deliveryFee === 0 ? 'FREE' : `₹${deliveryFee}`}</Text>
              </View>
              <View style={styles.billRow}>
                <Text style={styles.billLabel}>Handling Fee</Text>
                <Text style={styles.billVal}>₹5</Text>
              </View>
              <View style={[styles.billRow, { borderTopWidth: 1, borderColor: '#333', paddingTop: 8, marginTop: 4 }]}>
                <Text style={[styles.billLabel, { fontWeight: 'bold', color: '#fff' }]}>Grand Total</Text>
                <Text style={[styles.billVal, { fontWeight: 'bold', color: '#CCFF00' }]}>₹{grandTotal}</Text>
              </View>
            </View>

            <TouchableOpacity 
              style={styles.payNowBtn}
              onPress={() => {
                Alert.alert("Success!", "Order placed successfully!");
                setCart({});
                setIsCheckoutOpen(false);
              }}
            >
              <Text style={styles.payNowText}>Pay ₹{grandTotal}</Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

